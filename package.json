{
  "name": "novapil-landing",
  "private": true,
  "description": "Novapil-MD landing page (static, GitHub Pages). Run `npm run build:css` after changing Tailwind classes in index.html.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/tailwind.css --watch",
    "serve": "serve -l 4173 ."
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17"
  }
}
